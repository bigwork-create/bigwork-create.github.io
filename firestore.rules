rules_version = '2';

// Reglas de seguridad de Firestore para los comentarios de Fhuture'S (sección "Comentarios").
// - Cualquiera puede LEER los comentarios (son públicos).
// - Cualquiera puede CREAR uno (sin cuenta ni sesión), pero solo con los campos y largos
//   permitidos, sin enlaces y con la fecha del servidor.
// - Nadie puede EDITAR ni BORRAR comentarios desde la web. Hubert los borra con su programa de
//   escritorio "Moderar comentarios" (Admin SDK con cuenta de servicio, que no pasa por estas reglas).
service cloud.firestore {
  match /databases/{database}/documents {

    // Sin enlaces: rechaza "http", "www." y "://" en cualquier parte (sin distinguir mayúsculas).
    function sinEnlaces(t) {
      return !t.lower().matches('(?s).*(http|www[.]|://).*');
    }

    match /comentarios/{comentarioId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasOnly(['nombre', 'texto', 'creado'])
        && request.resource.data.keys().hasAll(['nombre', 'texto', 'creado'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 1
        && request.resource.data.nombre.size() <= 30
        && sinEnlaces(request.resource.data.nombre)
        && request.resource.data.texto is string
        && request.resource.data.texto.size() >= 3
        && request.resource.data.texto.size() <= 500
        && sinEnlaces(request.resource.data.texto)
        && request.resource.data.creado == request.time;

      allow update, delete: if false;
    }

    // Todo lo demás, cerrado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
